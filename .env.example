# TraderAI environment - copy to .env and fill in. NEVER commit .env.

# ── AI (the only cost in the system; budget tier ≈ $1-2/month) ───────────────
ANTHROPIC_API_KEY=          # console.anthropic.com - AI briefing, chat, debate
TYPESAFE_API_KEY=           # typesafe.ai - Jev typed probability signals (optional)

# ── App ──────────────────────────────────────────────────────────────────────
TRADING_API_TOKEN=          # any random string; auth for buy/sell/stop/cash
# REQUIRE_READ_AUTH=1       # uncomment to require the token on ALL endpoints

# ── Free data providers (all optional - yfinance works with zero keys) ──────
FRED_API_KEY=               # fred.stlouisfed.org - CPI, Fed funds, unemployment
FINNHUB_KEY=                # finnhub.io free tier - news + data fallback
NEWSAPI_KEY=                # newsapi.org free tier - macro narratives
TWELVEDATA_KEY=             # twelvedata.com free tier - data fallback
ALPHAVANTAGE_KEY=           # alphavantage.co free tier - data fallback
YOUTUBE_API_KEY=            # YouTube Data API v3 - community signal (optional)
SEC_CONTACT_EMAIL=          # your email - SEC EDGAR fair-access policy requires it
